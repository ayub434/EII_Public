### Create Preferred Vendor
POST http://localhost:4004/odata/v4/maverrick/Vendors
Content-Type: application/json

{
  "vendorName": "Dell India Pvt Ltd",
  "vendorCode": "V001",
  "preferredVendor": true,
  "country": "India",
  "city": "Bangalore",
  "riskScore": 10
}

### Create Non Preferred Vendor
POST http://localhost:4004/odata/v4/maverrick/Vendors
Content-Type: application/json

{
  "vendorName": "Local IT Supplier",
  "vendorCode": "V002",
  "preferredVendor": false,
  "country": "India",
  "city": "Bangalore",
  "riskScore": 40
}

### Create Contract
POST http://localhost:4004/odata/v4/maverrick/Contracts
Content-Type: application/json

{
  "contractNumber": "CT001",
  "title": "Laptop Procurement Contract",
  "startDate": "2025-01-01",
  "endDate": "2026-01-01",
  "contractValue": 5000000,
  "currency_code": "INR"
}

### Create Contract Item
POST http://localhost:4004/odata/v4/maverrick/ContractItems
Content-Type: application/json

{
  "parent_ID": "PUT_CONTRACT_ID_HERE",
  "itemCode": "LAP001",
  "itemDescription": "Business Laptop",
  "catalogItem": true,
  "unitPrice": 60000,
  "currency_code": "INR",
  "minQty": 1,
  "maxQty": 50
}

### Create PO (Valid Case)
POST http://localhost:4004/odata/v4/maverrick/PurchaseOrders
Content-Type: application/json

{
  "poNumber": "PO001",
  "vendor_ID": "PUT_VENDOR_ID",
  "contract_ID": "PUT_CONTRACT_ID",
  "orderDate": "2025-02-01",
  "grossAmount": 120000,
  "netAmount": 120000,
  "currency_code": "INR"
}

### Create PO Item Valid
POST http://localhost:4004/odata/v4/maverrick/POItems
Content-Type: application/json

{
  "parent_ID": "PUT_PO_ID",
  "itemCode": "LAP001",
  "quantity": 2,
  "unitPrice": 60000,
  "contractItem_ID": "PUT_CONTRACT_ITEM_ID",
  "currency_code": "INR"
}

### Maverick Price Variance
POST http://localhost:4004/odata/v4/maverrick/POItems
Content-Type: application/json

{
  "parent_ID": "PUT_PO_ID",
  "itemCode": "LAP001",
  "quantity": 1,
  "unitPrice": 70000,
  "contractItem_ID": "PUT_CONTRACT_ITEM_ID",
  "currency_code": "INR"
}

### Maverick Off Catalog
POST http://localhost:4004/odata/v4/maverrick/POItems
Content-Type: application/json

{
  "parent_ID": "PUT_PO_ID",
  "itemCode": "LAP999",
  "quantity": 1,
  "unitPrice": 50000,
  "currency_code": "INR"
}

### Get All POs
GET http://localhost:4004/odata/v4/maverrick/PurchaseOrders?$expand=items

### Maverick Results
GET http://localhost:4004/odata/v4/maverrick/PurchaseOrders?$select=poNumber,maverickFlag,maverickScore,maverickReason_code